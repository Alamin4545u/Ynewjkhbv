rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin() { return request.auth != null && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }

    match /config/main { allow read: if true; allow write: if isAdmin(); }
    match /admins/{id} { allow read: if request.auth != null && request.auth.uid == id; }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.coins == 0;
      allow update: if isAdmin() || (
        request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins','lastWrite','doneTasks','lastDaily','lastSpin'])
        && request.resource.data.coins - resource.data.coins <= 500
        && request.resource.data.coins >= 0
        && request.resource.data.lastWrite == request.time
        && request.time > resource.data.lastWrite + duration.value(2, 's'));
    }

    match /withdrawals/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.coins >= get(/databases/$(db)/documents/config/main).data.minWithdraw;
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }
  }
}
